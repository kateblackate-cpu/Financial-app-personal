run = "npm run dev -- --host 0.0.0.0 --port 5000"
entrypoint = "src/App.jsx"
modules = ["nodejs-22"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["npm", "run", "build"]
run = ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5000"]
deploymentTarget = "static"
publicDir = "dist"
